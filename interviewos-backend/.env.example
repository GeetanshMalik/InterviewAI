# App
APP_NAME=InterviewOS AI
APP_ENV=development
SECRET_KEY=your_super_secret_key_here_min_32_chars
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=
ALLOW_DEV_AUTH_FALLBACK=true

# Neon PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require
DATABASE_URL_SYNC=postgresql://user:password@host/dbname?sslmode=require

# AI Models
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER_ORDER=groq,gemini
LLM_LIVE_CALL_TIMEOUT_SECONDS=30
PLANNING_AGENT_LIVE_TIMEOUT_SECONDS=30
LLM_MAX_GROQ_CONCURRENT_REQUESTS=2
LLM_MAX_GEMINI_CONCURRENT_REQUESTS=1

# Optional: use separate keys per generation agent to avoid rate limits.
# If left blank, each agent uses GEMINI_API_KEY / GROQ_API_KEY.
DSA_GEMINI_API_KEY=
DSA_GROQ_API_KEY=
APTITUDE_GEMINI_API_KEY=
APTITUDE_GROQ_API_KEY=
TECHNICAL_GEMINI_API_KEY=
TECHNICAL_GROQ_API_KEY=
HR_GEMINI_API_KEY=
HR_GROQ_API_KEY=
EVALUATION_GEMINI_API_KEY=
EVALUATION_GROQ_API_KEY=

# Realtime Technical/HR voice pipeline
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=3600
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_ENDPOINTING_MS=800
DEEPGRAM_UTTERANCE_END_MS=1000

# Legacy external Judge0 fallback. Primary execution is CODE_EXECUTION_BACKEND=internal.
JUDGE0_BASE_URL=http://127.0.0.1:2358
JUDGE0_API_KEY=
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_RAPIDAPI_HOST=
JUDGE0_TIMEOUT_SECONDS=8
ENABLE_LOCAL_CODE_RUNNER=true
PREFER_LOCAL_CODE_RUNNER=true
LOCAL_CODE_RUNNER_COMPILE_TIMEOUT_SECONDS=10
LOCAL_CODE_RUNNER_TIMEOUT_SECONDS=3
CODE_EXECUTION_BACKEND=internal
CODE_EXECUTION_WORKSPACE_DIR=./data/code_execution
CODE_EXECUTION_MAX_SOURCE_BYTES=262144
CODE_EXECUTION_MAX_OUTPUT_BYTES=65536
CODE_EXECUTION_COMPILE_TIMEOUT_SECONDS=30
CODE_EXECUTION_RUN_TIMEOUT_SECONDS=5
CODE_EXECUTION_MEMORY_LIMIT_MB=1024

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db

# Workflow Queue
# inprocess is easiest for local development. Use redis with the worker command:
# python -m workers.workflow_worker
REDIS_URL=redis://localhost:6379/0
WORKFLOW_QUEUE_BACKEND=inprocess
WORKFLOW_QUEUE_NAME=interviewos:workflow:jobs
WORKFLOW_ASYNC_GENERATION=false
WORKFLOW_JOB_MAX_ATTEMPTS=3
WORKFLOW_RETRY_BASE_SECONDS=2
WORKFLOW_ENQUEUE_TIMEOUT_SECONDS=2
WORKFLOW_GENERATION_TIMEOUT_SECONDS=420
WORKFLOW_REDIS_BRPOP_TIMEOUT_SECONDS=5
WORKFLOW_WORKER_HEARTBEAT_SECONDS=5
WORKFLOW_QUEUE_PICKUP_GRACE_SECONDS=20
WORKFLOW_QUEUE_VISIBILITY_TIMEOUT_SECONDS=120
# Keep false in production so API requests do not perform slow in-process generation when the worker is unhealthy.
WORKFLOW_RECOVER_STALLED_REDIS_JOBS_IN_API=false
WORKFLOW_GRAPH_NODE_TIMEOUT_SECONDS=120
AGENT_GENERATION_MAX_CONCURRENT_SECTIONS=4
AGENT_SECTION_GENERATION_TIMEOUT_SECONDS=75

# Production Persistence
# Keep false for local JSON-store development. Enable in production after DATABASE_URL_SYNC is configured.
POSTGRES_PERSISTENCE_ENABLED=false
POSTGRES_PERSISTENCE_STRICT=false
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_STATEMENT_TIMEOUT_MS=8000
MIGRATIONS_DIR=./migrations
# chroma for local/dev; pgvector uses Postgres agent_memories when available.
SEMANTIC_MEMORY_BACKEND=chroma
# sentence-transformers is neural-first; hash remains the deterministic fallback if the model is unavailable.
SEMANTIC_EMBEDDING_PROVIDER=sentence-transformers
SENTENCE_TRANSFORMER_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SENTENCE_TRANSFORMER_LOCAL_FILES_ONLY=true
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
SEMANTIC_MEMORY_DEFERRED_FLUSH_DELAY_SECONDS=0.1
SEMANTIC_MEMORY_BATCH_FLUSH_SIZE=16
AGENTIC_TOOL_CALL_TIMEOUT_SECONDS=1.2
AGENTIC_TOOL_CALL_TOTAL_TIMEOUT_SECONDS=4

# Security classifier and human-in-loop graph interrupts
# Keep classifier disabled locally unless live AI keys are configured.
SECURITY_LLM_CLASSIFIER_ENABLED=false
SECURITY_LLM_CLASSIFIER_FAIL_CLOSED=false
LANGGRAPH_HUMAN_INTERRUPTS_ENABLED=false
LANGGRAPH_GENERATION_INTERRUPT_BEFORE=
LANGGRAPH_GENERATION_INTERRUPT_AFTER=
LANGGRAPH_LIFECYCLE_INTERRUPT_BEFORE=
LANGGRAPH_LIFECYCLE_INTERRUPT_AFTER=
LANGGRAPH_GENERATION_RECURSION_LIMIT=40
LANGGRAPH_LIFECYCLE_RECURSION_LIMIT=40
LANGGRAPH_MAX_GENERATION_ATTEMPTS=2
LANGGRAPH_MAX_DEBATE_ROUNDS=2
LANGGRAPH_MAX_ORCHESTRATOR_REPLANS=1
LANGGRAPH_MAX_LIFECYCLE_REVIEW_ATTEMPTS=2

# File Storage
UPLOAD_DIR=./uploads
RESUME_FILE_RETENTION_HOURS=24
RESUME_FILE_CLEANUP_INTERVAL_SECONDS=3600
DEV_STORE_PATH=./data/development_store.json
DEV_STORE_COMPACT_JSON=true
MAX_FILE_SIZE_MB=10

# Auth
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
