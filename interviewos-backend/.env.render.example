# Environment Variables for Render Deployment
# Copy these to your Render service settings

# ============================================
# REQUIRED - Application Settings
# ============================================
APP_ENV=production
SECRET_KEY=<generate-32-char-random-string>
JWT_SECRET=<generate-32-char-random-string>

# ============================================
# REQUIRED - Frontend URLs
# ============================================
FRONTEND_URL=https://your-frontend.vercel.app
FRONTEND_URLS=https://your-frontend.vercel.app,https://www.yourdomain.com

# ============================================
# REQUIRED - Database (Auto-configured by Render)
# ============================================
# DATABASE_URL=<provided-by-render-postgresql>
# DATABASE_URL_SYNC=<provided-by-render-postgresql>

# ============================================
# REQUIRED - Redis (Auto-configured by Render)
# ============================================
# REDIS_URL=<provided-by-render-redis>

# ============================================
# REQUIRED - LLM API Keys
# ============================================
GEMINI_API_KEY=<your-gemini-api-key>
GROQ_API_KEY=<your-groq-api-key>

# ============================================
# OPTIONAL - Feature-Specific LLM Keys
# (If not set, will use GEMINI_API_KEY/GROQ_API_KEY)
# ============================================
DSA_GEMINI_API_KEY=<optional>
DSA_GROQ_API_KEY=<optional>
APTITUDE_GEMINI_API_KEY=<optional>
APTITUDE_GROQ_API_KEY=<optional>
TECHNICAL_GEMINI_API_KEY=<optional>
TECHNICAL_GROQ_API_KEY=<optional>
HR_GEMINI_API_KEY=<optional>
HR_GROQ_API_KEY=<optional>
REPORT_GEMINI_API_KEY=<optional>
REPORT_GROQ_API_KEY=<optional>
ROADMAP_GEMINI_API_KEY=<optional>
ROADMAP_GROQ_API_KEY=<optional>
RESUME_GEMINI_API_KEY=<optional>
RESUME_GROQ_API_KEY=<optional>
BOT_GEMINI_API_KEY=<optional>
BOT_GROQ_API_KEY=<optional>
PLANNING_GEMINI_API_KEY=<optional>
PLANNING_GROQ_API_KEY=<optional>
MEMORY_GEMINI_API_KEY=<optional>
MEMORY_GROQ_API_KEY=<optional>
REVIEWER_GEMINI_API_KEY=<optional>
REVIEWER_GROQ_API_KEY=<optional>
PRACTICE_GEMINI_API_KEY=<optional>
PRACTICE_GROQ_API_KEY=<optional>
EVALUATION_GEMINI_API_KEY=<optional>
EVALUATION_GROQ_API_KEY=<optional>

# ============================================
# REQUIRED (if using real-time features) - LiveKit
# ============================================
LIVEKIT_URL=<your-livekit-url>
LIVEKIT_API_KEY=<your-livekit-api-key>
LIVEKIT_API_SECRET=<your-livekit-api-secret>

# ============================================
# REQUIRED (if using voice features) - Deepgram
# ============================================
DEEPGRAM_API_KEY=<your-deepgram-api-key>

# ============================================
# Database & Queue Configuration
# ============================================
POSTGRES_PERSISTENCE_ENABLED=true
POSTGRES_PERSISTENCE_STRICT=false
WORKFLOW_QUEUE_BACKEND=redis
WORKFLOW_ASYNC_GENERATION=true

# ============================================
# File Storage Paths
# ============================================
CHROMA_PERSIST_DIR=/opt/render/project/src/chroma_db
UPLOAD_DIR=/opt/render/project/src/uploads
CODE_EXECUTION_WORKSPACE_DIR=/opt/render/project/src/data/code_execution
DEV_STORE_PATH=/opt/render/project/src/data/development_store.json

# ============================================
# OPTIONAL - Performance Tuning
# ============================================
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
LLM_MAX_GEMINI_CONCURRENT_REQUESTS=2
LLM_MAX_GROQ_CONCURRENT_REQUESTS=3
AGENT_GENERATION_MAX_CONCURRENT_SECTIONS=2

# ============================================
# OPTIONAL - Timeout Configuration
# ============================================
WORKFLOW_GENERATION_TIMEOUT_SECONDS=420
WORKFLOW_GRAPH_NODE_TIMEOUT_SECONDS=120
AGENT_SECTION_GENERATION_TIMEOUT_SECONDS=90

# ============================================
# OPTIONAL - Code Execution
# ============================================
CODE_EXECUTION_BACKEND=internal
ENABLE_LOCAL_CODE_RUNNER=true
PREFER_LOCAL_CODE_RUNNER=true

# ============================================
# OPTIONAL - Security
# ============================================
SECURITY_LLM_CLASSIFIER_ENABLED=false
ALLOW_DEV_AUTH_FALLBACK=false
